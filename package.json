{
  "name": "unu-engine-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"vite build --config vite.electron.config.ts --watch\" \"wait-on tcp:5173 dist-electron/main.js dist-electron/preload.js && electron .\"",
    "dev:electron": "vite build --config vite.electron.config.ts --watch",
    "build": "vite build && vite build --config vite.electron.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --config electron-builder.json --win dir",
    "dist:win:installer": "npm run build && electron-builder --config electron-builder.json --win",
    "preview": "vite preview",
    "assets:audit": "node scripts/audit-assets.cjs",
    "assets:sync-public": "node scripts/sync-public-assets.cjs",
    "start:electron": "wait-on tcp:5173 dist-electron/main.js dist-electron/preload.js && electron ."
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "pixi.js": "^8.9.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.4",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.9.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.3"
  }
}
